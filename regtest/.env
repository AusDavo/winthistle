# Image versions. bitcoind is Polar's image; LND is Lightning Labs' own, because
# Polar publishes no LND tag past 0.20.0-beta and the harness has to run the
# version an operator actually runs. Note the tags differ in shape: Polar's LND
# tags had no `v`, Lightning Labs' do.
# Available tags: hub.docker.com/r/polarlightning/bitcoind , .../lightninglabs/lnd
BITCOIND_VERSION=29.0
LND_VERSION=v0.21.2-beta

# Regtest-only credentials. Deliberately fake and deliberately committed —
# if you ever feel tempted to reuse these anywhere, that is the tell.
RPCUSER=winthistle
RPCPASS=winthistle

# Container user for bitcoind's entrypoint, so files written into its named
# volume are yours. Lightning Labs' LND image has no such shim and runs as root;
# its state is in named volumes, so nothing lands in your tree either way.
USERID=1000
GROUPID=1000

# maxpendingchannels is 200, not the 10 Polar would give you, because
# AbandonChannel is local-only: the *peer* keeps its side pending until 2016
# blocks pass from the funding height, so every abort test permanently consumes
# one of that peer's pending slots and the harness poisons itself after a few
# runs. `make reset` is still the cure; this just moves it a long way off.
#
# Flags shared by every LND node. They live here rather than in the compose file
# because YAML cannot splice a sequence into another sequence, and a `command`
# in list form is NOT word-split — an anchor would arrive as one argv entry.
# Interpolated into a string command instead, which compose does split.
LND_FLAGS=--noseedbackup --trickledelay=50 --maxpendingchannels=200 --accept-positive-inbound-fees --protocol.wumbo-channels --listen=0.0.0.0:9735 --rpclisten=0.0.0.0:10009 --restlisten=0.0.0.0:8080 --tlsextraip=127.0.0.1 --tlsextradomain=localhost --bitcoin.active --bitcoin.regtest --bitcoin.node=bitcoind --bitcoind.rpchost=bitcoind:18443 --bitcoind.rpcuser=winthistle --bitcoind.rpcpass=winthistle --bitcoind.zmqpubrawblock=tcp://bitcoind:28334 --bitcoind.zmqpubrawtx=tcp://bitcoind:28335
