# Image versions. Both are Polar's images, so the invocation below matches what
# Polar itself generates — handy if you use the GUI to learn and this to test.
# Available tags: hub.docker.com/r/polarlightning/bitcoind , .../lnd
BITCOIND_VERSION=29.0
LND_VERSION=0.19.3-beta

# Regtest-only credentials. Deliberately fake and deliberately committed —
# if you ever feel tempted to reuse these anywhere, that is the tell.
RPCUSER=winthistle
RPCPASS=winthistle

# Container user, so files written into named volumes are yours.
USERID=1000
GROUPID=1000

# Flags shared by every LND node. They live here rather than in the compose file
# because YAML cannot splice a sequence into another sequence, and a `command`
# in list form is NOT word-split — an anchor would arrive as one argv entry.
# Interpolated into a string command instead, which compose does split.
LND_FLAGS=--noseedbackup --trickledelay=50 --maxpendingchannels=10 --accept-positive-inbound-fees --protocol.wumbo-channels --listen=0.0.0.0:9735 --rpclisten=0.0.0.0:10009 --restlisten=0.0.0.0:8080 --tlsextraip=127.0.0.1 --tlsextradomain=localhost --bitcoin.active --bitcoin.regtest --bitcoin.node=bitcoind --bitcoind.rpchost=bitcoind:18443 --bitcoind.rpcuser=winthistle --bitcoind.rpcpass=winthistle --bitcoind.zmqpubrawblock=tcp://bitcoind:28334 --bitcoind.zmqpubrawtx=tcp://bitcoind:28335
