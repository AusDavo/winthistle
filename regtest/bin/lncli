#!/usr/bin/env bash
# lncli against one node, named first.  ./bin/lncli alice getinfo
set -euo pipefail
cd "$(dirname "$0")/.."
node=${1:?usage: lncli <alice|bob|carol|dave> <args...>}; shift
# --lnddir is stated rather than inherited: it is /root/.lnd only because
# Lightning Labs' image runs LND as root, and Polar's — which this harness used
# until the 0.21.2 bump — put it under /home/lnd instead.
exec docker compose exec -T "$node" lncli --network=regtest --lnddir=/root/.lnd "$@"
