# --- Secrets and node credentials: never commit ---
*.macaroon
*.cert
*.key
*.pem
.cookie
winthistle.toml
*.local.toml
.env
.env.*
# ...but the harnesses' .env files are required for them to run, and hold only
# version pins and deliberately-fake credentials for chains where coins are free.
# internal/regtestenv and internal/signetenv read the RPC user and password out
# of these rather than hardcoding them, so an ignored one breaks the tests with
# "harness not configured".
!regtest/.env
!signet/.env

# --- Run state: contains outpoints, peer sets, raw transactions ---
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
# Anchored to the repo root on purpose. Unanchored, `journal/` also matches
# internal/journal/ — the run journal's *source*, silently un-committable.
/runs/
/journal/

# --- PSBTs and wallet exports: xpubs deanonymise the whole wallet ---
*.psbt
*.txn
descriptors*.json
*wallet-export*
!testdata/**/*.psbt

# The cold wallet's descriptor file, which `winthistle setup` reads: two
# extended public keys and a date. One xpub deanonymises the whole wallet's
# history, permanently, and git history cannot be un-published. These are the
# names the README, the design and doctor's fix lines use.
cold.toml
cold-*.toml
descriptors.toml
*-descriptors.toml

# The batch file: which peers, how much, and when. Not key material, and
# exactly the set of facts the no-third-party-APIs rule exists to keep off
# other people's servers — so it does not belong in a repo either.
batch.toml
batch-*.toml

# --- Build output ---
/winthistle
/dist/
/build/
*.exe

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# harness runtime output
regtest/creds/
regtest/__pycache__/
signet/__pycache__/
