# Image version. Polar's bitcoind image, the same one regtest/ runs — this
# harness is "add a bitcoind", not "stand up signet", so there is no LND pin
# here and no LND node in the compose file.
# Available tags: hub.docker.com/r/polarlightning/bitcoind
BITCOIND_VERSION=29.0

# Signet-only credentials. Deliberately fake and deliberately committed — this
# node holds no keys and signet coins are free. If you ever feel tempted to
# reuse these anywhere, that is the tell.
RPCUSER=winthistle
RPCPASS=winthistle

# Container user, so files written into named volumes are yours.
USERID=1000
GROUPID=1000

# The pruned node's target, in MiB. 550 is Core's minimum. Signet's chain is a
# few gigabytes, so this leaves a prune horizon well inside the chain — which is
# the whole point: coldwallet.PrunedPastBirthday needs something to fire on.
PRUNE_MB=550
